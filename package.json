{
  "name": "codegraph",
  "displayName": "CodeGraph",
  "description": "Local-first VS Code codebase graph, hover memory, and grounded explanations. (Formerly DuckGraph; duckgraph.* commands and settings still work.)",
  "version": "0.2.0",
  "publisher": "kilocode-x",
  "license": "MIT",
  "private": false,
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "llm",
    "graph",
    "hover",
    "local-first",
    "code-intelligence"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:rust",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:python",
    "onCommand:codegraph.reindexWorkspace",
    "onCommand:codegraph.explainAtCursor",
    "onCommand:codegraph.showOrbitGraph",
    "onCommand:codegraph.clearCache",
    "onCommand:codegraph.confirmInferredEdge",
    "onCommand:codegraph.dismissInferredEdge",
    "onCommand:duckgraph.reindexWorkspace",
    "onCommand:duckgraph.explainAtCursor",
    "onCommand:duckgraph.showOrbitGraph",
    "onCommand:duckgraph.clearCache",
    "onCommand:duckgraph.confirmInferredEdge",
    "onCommand:duckgraph.dismissInferredEdge"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codegraph.reindexWorkspace",
        "title": "Reindex Workspace",
        "category": "CodeGraph",
        "icon": "$(sync)"
      },
      {
        "command": "codegraph.explainAtCursor",
        "title": "Explain Symbol at Cursor",
        "category": "CodeGraph",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "codegraph.showOrbitGraph",
        "title": "Show Orbit Graph",
        "category": "CodeGraph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "codegraph.clearCache",
        "title": "Clear Explanation Cache",
        "category": "CodeGraph",
        "icon": "$(trash)"
      },
      {
        "command": "codegraph.confirmInferredEdge",
        "title": "Confirm Inferred Edge",
        "category": "CodeGraph"
      },
      {
        "command": "codegraph.dismissInferredEdge",
        "title": "Dismiss Inferred Edge",
        "category": "CodeGraph"
      },
      {
        "command": "duckgraph.reindexWorkspace",
        "title": "Reindex Workspace (legacy alias)",
        "category": "CodeGraph"
      },
      {
        "command": "duckgraph.explainAtCursor",
        "title": "Explain Symbol at Cursor (legacy alias)",
        "category": "CodeGraph"
      },
      {
        "command": "duckgraph.showOrbitGraph",
        "title": "Show Orbit Graph (legacy alias)",
        "category": "CodeGraph"
      },
      {
        "command": "duckgraph.clearCache",
        "title": "Clear Explanation Cache (legacy alias)",
        "category": "CodeGraph"
      },
      {
        "command": "duckgraph.confirmInferredEdge",
        "title": "Confirm Inferred Edge (legacy alias)",
        "category": "CodeGraph"
      },
      {
        "command": "duckgraph.dismissInferredEdge",
        "title": "Dismiss Inferred Edge (legacy alias)",
        "category": "CodeGraph"
      }
    ],
    "keybindings": [
      {
        "command": "codegraph.explainAtCursor",
        "key": "alt+d",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "codegraph.showOrbitGraph",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "CodeGraph",
      "properties": {
        "codegraph.llamaUrl": {
          "type": "string",
          "default": "http://localhost:8080/completion",
          "description": "Local llama.cpp HTTP completion endpoint. CodeGraph never calls cloud services."
        },
        "codegraph.userLevel": {
          "type": "string",
          "enum": [
            "beginner",
            "intermediate",
            "expert"
          ],
          "default": "intermediate",
          "description": "Explanation depth preference used by the prompt router."
        },
        "codegraph.enabledLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "rust",
            "typescript",
            "typescriptreact",
            "python"
          ],
          "description": "Languages CodeGraph indexes and explains."
        },
        "codegraph.hoverMode": {
          "type": "string",
          "enum": [
            "always",
            "commandOnly"
          ],
          "default": "always",
          "description": "Whether CodeGraph participates in native hovers or only explains via commands."
        },
        "codegraph.indexOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Index supported workspace files when CodeGraph activates."
        },
        "codegraph.maxEdges": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 100,
          "description": "Circuit breaker for highly referenced graph nodes."
        },
        "codegraph.debugGraphJson": {
          "type": "boolean",
          "default": false,
          "description": "Append compact graph JSON to hovers for local debugging."
        },
        "duckgraph.llamaUrl": {
          "type": "string",
          "default": "http://localhost:8080/completion",
          "description": "Legacy alias for codegraph.llamaUrl.",
          "deprecationMessage": "Use codegraph.llamaUrl instead."
        },
        "duckgraph.userLevel": {
          "type": "string",
          "enum": [
            "beginner",
            "intermediate",
            "expert"
          ],
          "default": "intermediate",
          "description": "Legacy alias for codegraph.userLevel.",
          "deprecationMessage": "Use codegraph.userLevel instead."
        },
        "duckgraph.enabledLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "rust",
            "typescript",
            "typescriptreact",
            "python"
          ],
          "description": "Legacy alias for codegraph.enabledLanguages.",
          "deprecationMessage": "Use codegraph.enabledLanguages instead."
        },
        "duckgraph.hoverMode": {
          "type": "string",
          "enum": [
            "always",
            "commandOnly"
          ],
          "default": "always",
          "description": "Legacy alias for codegraph.hoverMode.",
          "deprecationMessage": "Use codegraph.hoverMode instead."
        },
        "duckgraph.indexOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Legacy alias for codegraph.indexOnStartup.",
          "deprecationMessage": "Use codegraph.indexOnStartup instead."
        },
        "duckgraph.maxEdges": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 100,
          "description": "Legacy alias for codegraph.maxEdges.",
          "deprecationMessage": "Use codegraph.maxEdges instead."
        },
        "duckgraph.debugGraphJson": {
          "type": "boolean",
          "default": false,
          "description": "Legacy alias for codegraph.debugGraphJson.",
          "deprecationMessage": "Use codegraph.debugGraphJson instead."
        }
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "copy:assets": "node scripts/copy-assets.mjs",
    "build": "npm run copy:assets && node scripts/build.mjs",
    "build:production": "node scripts/build-production.mjs",
    "release": "node scripts/make-release.mjs",
    "watch": "npm run copy:assets && node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run copy:assets && vitest run",
    "test:extension": "npm run build && node scripts/run-extension-tests.mjs",
    "package": "npm run build && vsce package --allow-missing-repository --no-dependencies"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "chokidar": "^4.0.3",
    "d3": "^7.9.0",
    "express": "^5.2.1",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "@types/vscode": "^1.120.0",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "supertest": "^7.1.4",
    "typescript": "^6.0.3",
    "vitest": "^4.0.14"
  }
}
